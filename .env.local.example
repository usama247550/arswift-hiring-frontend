# Used only on the Next.js server. Never exposed to the browser.
API_URL=http://localhost:5000
API_KEY=same-value-as-in-backend-env

# Password for the dashboard (sir and HR share it). Use a long one, for example four random words.
DASHBOARD_PASSWORD=
# Random text that signs the login cookie. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
